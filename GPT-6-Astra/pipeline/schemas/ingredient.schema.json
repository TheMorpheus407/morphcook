{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MorphCook ingredient",
  "type": "object",
  "required": [
    "id",
    "name",
    "parent_id",
    "flags",
    "aisle"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "object",
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "aisle": {
      "type": "object",
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
