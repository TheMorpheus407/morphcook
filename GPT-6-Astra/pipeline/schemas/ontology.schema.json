{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MorphCook additive ontology",
  "type": "object",
  "required": [
    "flags",
    "compounds",
    "dimensions",
    "attributes"
  ],
  "properties": {
    "flags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "object",
            "required": [
              "en",
              "de"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "de": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "compounds": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    },
    "compound_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "en",
          "de"
        ],
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1
          },
          "de": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "values"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "object",
            "required": [
              "en",
              "de"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "de": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "object",
                  "required": [
                    "en",
                    "de"
                  ],
                  "properties": {
                    "en": {
                      "type": "string",
                      "minLength": 1
                    },
                    "de": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    }
  }
}
