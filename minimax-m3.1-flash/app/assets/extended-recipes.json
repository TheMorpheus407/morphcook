          "unit": "tbsp"
        },
        {
          "ingredient_id": "pantry.cumin",
          "name": {
            "en": "Cumin",
            "de": "Kreuzkümmel"
          },
          "quantity": 1,
          "unit": "tsp"
        }
      ],
      "steps": [
        {
          "instruction": {
            "en": "Rinse the quinoa well, then simmer it in twice its volume of water for 15 minutes until fluffy.",
            "de": "Spüle die Quinoa gründlich und koche sie dann 15 Minuten in der doppelten Menge Wasser, bis sie locker ist."
          }
        },
        {
          "instruction": {
            "en": "Toss the sweet potato and chickpeas with oil, cumin and salt, and roast at 220°C for 25 minutes until the edges caramelise.",
            "de": "Wende Süßkartoffel und Kichererbsen in Öl, Kreuzkümmel und Salz und röste sie 25 Minuten bei 220 °C, bis die Ränder karamellisieren."
          }
        },
        {
          "instruction": {
            "en": "Massage the kale with a little olive oil and salt to soften it.",
            "de": "Massiere den Grünkohl mit etwas Olivenöl und Salz, damit er weich wird."
          }
        },
        {
          "instruction": {
            "en": "Whisk the tahini with the lemon juice, maple syrup and enough cold water to make a pourable dressing.",
            "de": "Rühre Tahini, Zitronensaft und Ahornsyrup mit genug kaltem Wasser cremig."
          }
        },
        {
          "instruction": {
            "en": "Build the bowls: quinoa first, then the roasted vegetables and chickpeas, kale and avocado.",
            "de": "Baue die Schalen: zuerst Quinoa, dann das geröstete Gemüse und die Kichererbsen, Grünkohl und Avocado."
          }
        },
        {
          "instruction": {
            "en": "Drizzle over the tahini dressing and serve.",
            "de": "Gieße das Tahini-Dressing darüber und serviere."
          }
        }
      ],
