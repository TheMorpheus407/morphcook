    {
      "id": "shroom-pasta-classic",
      "dish_id": "shroom-pasta",
      "diet": "classic",
      "title": {
        "en": "Classic Mushroom Pasta",
        "de": "Klassische Pilzpasta"
      },
      "hero_text": {
        "en": "Mushrooms browned until they squeak, garlic, thyme, and pasta water.",
        "de": "Bis sie quietschen gebräunte Pilze, Knoblauch, Thymian und Pastawasser."
      },
      "cap_caption": {
        "en": "brown them properly",
        "de": "bräune sie richtig"
      },
      "stripe_color": "#8A6A82",
      "ingredients": [
        {
          "ingredient_id": "pantry.pasta.penne",
          "name": {
            "en": "Penne",
            "de": "Penne"
          },
          "quantity": 250,
          "unit": "g"
        },
        {
          "ingredient_id": "produce.mushroom.chestnut",
          "name": {
            "en": "Chestnut mushrooms",
            "de": "Riesenchampignons"
          },
          "quantity": 400,
          "unit": "g",
          "preparation": {
            "en": "sliced thickly",
            "de": "dick geschnitten"
          }
        },
        {
          "ingredient_id": "produce.garlic",
          "name": {
            "en": "Garlic",
            "de": "Knoblauch"
          },
          "quantity": 3,
          "unit": "clove",
          "preparation": {
            "en": "sliced",
            "de": "in Scheiben"
          }
        },
        {
          "ingredient_id": "dairy.butter",
          "name": {
            "en": "Butter",
            "de": "Butter"
          },
          "quantity": 40,
          "unit": "g"
        },
        {
          "ingredient_id": "dairy.cheese.parmesan",
          "name": {
            "en": "Parmesan",
            "de": "Parmesan"
          },
          "quantity": 50,
          "unit": "g",
          "preparation": {
            "en": "grated",
            "de": "gerieben"
          }
        },
        {
          "ingredient_id": "produce.herbs.thyme",
          "name": {
            "en": "Thyme",
            "de": "Thymian"
          },
          "quantity": 8,
          "unit": "g"
        },
        {
          "ingredient_id": "pantry.oil.olive",
          "name": {
            "en": "Olive oil",
            "de": "Olivenöl"
          },
          "quantity": 2,
          "unit": "tbsp"
        },
        {
          "ingredient_id": "pantry.salt.sea",
          "name": {
            "en": "Sea salt",
            "de": "Meersalz"
          },
          "quantity": 1,
          "unit": "tsp"
        }
      ],
      "steps": [
        {
          "instruction": {
            "en": "Fry the mushrooms in olive oil over high heat in a single layer, in batches, until deeply golden. Salt them only at the end.",
            "de": "Brate die Pilze in Olivenöl über starker Hitze in einer Schicht, portionsweise, bis sie tief goldbraun sind. Salze sie erst am Ende."
          }
        },
        {
          "instruction": {
            "en": "Cook the penne in well-salted water until al dente, keeping a cup of the water.",
            "de": "Koche die Penne in gut gesalzenem Wasser al dente und hebe eine Tasse Wasser auf."
          }
        },
        {
          "instruction": {
            "en": "Melt the butter in the pan, add the garlic and thyme, and cook for one minute until fragrant.",
            "de": "Schmelze die Butter in der Pfanne, gib Knoblauch und Thymian dazu und koche eine Minute, bis es duftet."
          }
        },
        {
          "instruction": {
            "en": "Add the pasta and a good splash of pasta water and toss hard until the sauce clings to every penne.",
            "de": "Gib die Nudeln und einen guten Schuss Pastawasser dazu und schwenke kräftig, bis die Sauce an jeder Penne hängt."
          }
        },
        {
          "instruction": {
            "en": "Off the heat, fold in the parmesan and more pasta water, then serve at once.",
            "de": "Nimm die Pfanne von der Platte, rühre den Parmesan und mehr Pastawasser ein und serviere sofort."
          }
        }
      ],
      "contains": [
        "dairy",
        "gluten",
        "high-fodmap"
      ],
