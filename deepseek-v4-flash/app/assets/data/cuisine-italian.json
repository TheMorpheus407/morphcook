    {
      "id": "alfredo-classic",
      "dish_id": "alfredo",
      "title": {
        "en": "silky alfredo",
        "de": "butteriges alfredo"
      },
      "summary": {
        "en": "parmesan & cream doing a slow dance with fettuccine.",
        "de": "parmesan & sahne tanzen langsam mit fettuccine."
      },
      "diet": "classic",
      "contains": [
        "dairy",
        "gluten",
        "high-fodmap"
      ],
      "attributes": [
        "easy",
        "≤30",
        "≤800",
        "simmer",
        "stir-fry",
        "cuisine-italian"
      ],
      "time_minutes": 20,
      "calories_per_serving": 680,
      "protein_g": 22,
      "carbs_g": 68,
      "fat_g": 35,
      "servings": 4,
      "meal_types": [
        "dinner"
      ],
      "tags": [
        "pasta",
        "italian",
        "comfort"
      ],
      "ingredients": [
        {
          "id": "spaghetti",
          "amount": 400.0,
          "unit": "g"
        },
        {
          "id": "butter",
          "amount": 60.0,
          "unit": "g"
        },
        {
          "id": "cream",
          "amount": 200.0,
          "unit": "ml"
        },
        {
          "id": "parmesan",
          "amount": 80.0,
          "unit": "g"
        },
        {
          "id": "garlic",
          "amount": 2.0,
          "unit": "clove"
        },
        {
          "id": "black-pepper",
          "amount": 2.0,
          "unit": "tsp"
        },
        {
          "id": "salt",
          "amount": 1.0,
          "unit": "tsp"
        }
      ],
      "steps": [
        {
          "text": {
            "en": "cook pasta in heavily salted water, save a cup of the starchy water.",
            "de": "pasta in stark gesalzenem wasser kochen, eine tasse nudelwasser aufheben."
          },
          "timer_seconds": 600
        },
        {
          "text": {
            "en": "melt butter with garlic over low heat, never browning.",
            "de": "butter mit knoblauch bei niedriger hitze schmelzen, nicht bräunen."
          },
          "timer_seconds": 120
        },
        {
          "text": {
            "en": "pour in cream and simmer gently 3 min.",
            "de": "sahne angießen und 3 min sanft köcheln."
          },
          "timer_seconds": 180
        },
        {
          "text": {
            "en": "drag the pasta into the sauce with a splash of pasta water.",
            "de": "pasta mit etwas nudelwasser in die sauce ziehen."
          }
        },
        {
          "text": {
            "en": "off the heat: rain in parmesan, toss until it turns glossy.",
            "de": "vom herd: parmesan hineinrieseln lassen, schwenken bis es glänzt."
          }
        },
        {
          "text": {
            "en": "a wallop of black pepper, and done.",
            "de": "mit viel schwarzem pfeffer, fertig."
          }
        }
      ],
      "kitchen_notes": {
        "en": "the sauce looks broken for a second — keep tossing, it heals.",
        "de": "die sauce sieht kurz getrennt aus — weiter schwenken, sie heilt."
      },
      "reviewed": true
    },
    {
