        },
        {
          "id": "tomato",
          "amount": 2.0,
          "unit": "piece"
        },
        {
          "id": "cucumber",
          "amount": 1.0,
          "unit": "piece"
        },
        {
          "id": "yogurt",
          "amount": 150.0,
          "unit": "g"
        },
        {
          "id": "lemon",
          "amount": 0.5,
          "unit": "piece"
        },
        {
          "id": "parsley",
          "amount": 1.0,
          "unit": "handful"
        }
      ],
      "steps": [
        {
          "text": {
            "en": "grate the onion & garlic into the minced meat, add spices & salt.",
            "de": "zwiebel & knoblauch ins hack reiben, gewürze & salz dazu."
          }
        },
        {
          "text": {
            "en": "knead well and press onto a sheet pan in a wide loaf shape.",
            "de": "gut kneten und als flaches laib auf ein blech drücken."
          }
        },
        {
          "text": {
            "en": "roast at 220°c, turning once, until deeply browned — about 30 min.",
            "de": "bei 220°c braten, einmal wenden, bis tiefbraun — ca. 30 min."
          },
          "timer_seconds": 1800
        },
        {
          "text": {
            "en": "rest the loaf 10 min, then slice thin.",
            "de": "laib 10 min ruhen lassen, dann dünn aufschneiden."
          },
          "timer_seconds": 600
        },
        {
          "text": {
            "en": "warm the pitas, toss cabbage with lemon & salt, slice tomatoes & cucumber.",
            "de": "pitas erwärmen, kohl mit zitrone & salz mischen, tomaten & gurke schneiden."
          }
        },
        {
          "text": {
            "en": "swipe yogurt over bread, pile on meat & salad, roll it up.",
            "de": "joghurt aufs brot, fleisch & salat drauf, einrollen."
          }
        }
      ],
      "kitchen_notes": {
        "en": "don't skip the resting — it keeps the slices juicy.",
        "de": "das ruhen nicht überspringen — das hält die scheiben saftig."
      },
      "reviewed": true
    },
