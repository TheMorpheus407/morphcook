          }
        },
        {
          "text": {
            "en": "vegan mayo on the bread, then meat & salad, roll tight.",
            "de": "vegane mayo aufs brot, dann fleisch & salat, fest einrollen."
          }
        }
      ],
      "kitchen_notes": {
        "en": "tahini instead of mayo is also very right.",
        "de": "tahini statt mayo ist auch sehr richtig."
      },
