        "roast",
        "cuisine-middle-eastern"
      ],
      "time_minutes": 45,
      "calories_per_serving": 620,
      "protein_g": 38,
      "carbs_g": 55,
      "fat_g": 26,
      "servings": 4,
      "meal_types": [
        "dinner",
        "lunch"
      ],
      "tags": [
