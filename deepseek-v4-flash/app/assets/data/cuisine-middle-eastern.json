    {
      "id": "doener-classic",
      "dish_id": "doener",
      "title": {
        "en": "classic döner",
        "de": "klassischer döner"
      },
      "summary": {
        "en": "lamb & beef from a slow spit, crisp-edged, with good bread.",
        "de": "lamm & rind vom drehspieß, knusprig geröstet, auf gutem brot."
      },
      "diet": "classic",
      "contains": [
        "beef",
        "dairy",
        "gluten",
        "high-fodmap",
        "lamb"
      ],
      "attributes": [
