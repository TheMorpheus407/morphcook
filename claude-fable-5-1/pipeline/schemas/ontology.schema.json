{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://morphcook.app/schemas/ontology.schema.json",
  "title": "MorphCook ontology",
  "type": "object",
  "required": ["schema_version", "version", "contains_flags", "compound_flags", "attributes", "dimensions", "meal_types", "aisles", "units"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "version": {"type": "string"},
    "contains_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "group"],
        "properties": {
          "id": {"type": "string"},
          "label": {"$ref": "ltext.schema.json"},
          "group": {"type": "string"},
          "parent": {"type": "string"}
        }
      }
    },
    "compound_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "expands_to"],
        "properties": {
          "id": {"type": "string"},
          "label": {"$ref": "ltext.schema.json"},
          "description": {"$ref": "ltext.schema.json"},
          "expands_to": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "attributes": {
      "type": "object",
      "required": ["effort", "time_bucket", "calorie_bucket", "technique", "positive"]
    },
    "dimensions": {"type": "array", "minItems": 1},
    "meal_types": {"type": "array"},
    "aisles": {"type": "array"},
    "units": {"type": "array"}
  }
}
