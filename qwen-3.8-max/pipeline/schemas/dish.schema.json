{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "morphcook/dish.schema.json",
  "title": "Dish",
  "description": "A dish concept linking its sibling variant recipes, with partition routing.",
  "type": "object",
  "required": [
    "id", "name", "stripe_color", "recipe_ids", "partition_id"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "$ref": "#/definitions/l10n" },
    "hero": { "$ref": "#/definitions/l10n" },
    "cap_caption": { "$ref": "#/definitions/l10n" },
    "stripe_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "recipe_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "partition_id": { "type": "string", "enum": ["core", "extended"] },
    "secondary_partitions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^cuisine-[a-z-]+$" }
    },
    "cuisine_tags": { "type": "array", "items": { "type": "string" } },
    "frequency_tier": { "type": "integer", "minimum": 1, "maximum": 3 },
    "categories": { "type": "array", "items": { "type": "string" } },
    "meal_slots": {
      "type": "array",
      "items": { "enum": ["breakfast", "lunch", "dinner"] }
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "l10n": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    }
  }
}
