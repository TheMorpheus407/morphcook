{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphcook.app/schemas/dish.schema.json",
  "title": "MorphCook Dish Concept",
  "type": "object",
  "required": [
    "id", "canonical_name", "hero", "cap_caption", "stripe_color",
    "variants", "partition_id", "secondary_partitions", "cuisine_tags",
    "frequency_tier"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "canonical_name": { "$ref": "recipe.schema.json#/$defs/ltext" },
    "hero": {
      "allOf": [{ "$ref": "recipe.schema.json#/$defs/ltext" }],
      "description": "one-line evocation under the dish title"
    },
    "cap_caption": { "$ref": "recipe.schema.json#/$defs/ltext" },
    "stripe_color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "description": "color of the striped placeholder illustration"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "recipe ids of all variants of this dish"
    },
    "partition_id": { "enum": ["core", "extended"] },
    "secondary_partitions": {
      "type": "array",
      "items": { "enum": ["italian", "asian", "middle-eastern"] },
      "uniqueItems": true
    },
    "cuisine_tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z-]+$" },
      "uniqueItems": true
    },
    "frequency_tier": { "type": "integer", "minimum": 1, "maximum": 3 },
    "meal_type": { "enum": ["breakfast", "lunch", "dinner"] }
  }
}
