    {
      "id": "falafel-classic",
      "dish_id": "falafel",
      "title": {
        "en": "Crispy Falafel in Pita",
        "de": "Knusprige Falafel im Fladenbrot"
      },
      "blurb": {
        "en": "Soaked — never cooked — chickpeas, a mountain of herbs, deep-fried until they shatter. Tahini, tomato, pickled onion.",
        "de": "Eingeweichte — nie gekochte — Kichererbsen, ein Berg Kräuter, frittiert, bis sie knacken. Tahini, Tomate, eingelegte Zwiebel."
      },
      "note": {
        "en": "soak the chickpeas the night before. canned ones fall apart.",
        "de": "kichererbsen am vorabend einweichen. dosenware zerfällt."
      },
      "cuisine": "levantine",
      "diet": "classic",
      "effort": "hard",
      "time_minutes": 60,
      "time_bucket": "<=60",
      "servings": 4,
