          "unit": "to-taste"
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Drain the soaked chickpeas well and pulse with onion, garlic, herbs and spices until finely crumbly, not a paste.",
            "de": "Eingeweichte Kichererbsen gut abtropfen und mit Zwiebel, Knoblauch, Kräutern und Gewürzen fein krümelig mixen, nicht zu einer Paste."
          }
        },
        {
          "text": {
            "en": "Stir in salt, baking soda and flour and chill the mix.",
            "de": "Salz, Natron und Mehl einrühren und die Masse kühlen."
          },
          "timer_seconds": 1200
        },
        {
          "text": {
            "en": "Heat the oil to 175 °C. Shape walnut-sized balls and fry in batches until deep brown.",
            "de": "Öl auf 175 °C erhitzen. Walnussgroße Bällchen formen und portionsweise dunkelbraun frittieren."
          },
          "timer_seconds": 240
        },
        {
          "text": {
            "en": "Whisk tahini with lemon juice, salt and cold water until pale and pourable.",
            "de": "Tahini mit Zitronensaft, Salz und kaltem Wasser hell und flüssig schlagen."
          }
        },
        {
          "text": {
            "en": "Stuff warm pita with falafel, tomato, cucumber and plenty of tahini sauce.",
            "de": "Warmes Fladenbrot mit Falafel, Tomate, Gurke und reichlich Tahinisauce füllen."
          }
        }
      ]
    },
