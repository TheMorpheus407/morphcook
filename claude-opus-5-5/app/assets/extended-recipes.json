      "steps": [
        {
          "text": {
            "en": "Heat the oven to 180 °C and line a 20 × 20 cm tin. Melt chocolate and butter together gently.",
            "de": "Ofen auf 180 °C vorheizen, eine 20 × 20 cm Form auslegen. Schokolade und Butter sanft zusammen schmelzen."
          }
