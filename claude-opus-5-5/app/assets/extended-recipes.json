    {
      "id": "caesar-classic",
      "dish_id": "caesar",
      "title": {
        "en": "Classic Caesar Salad",
        "de": "Klassischer Caesar Salad"
      },
      "blurb": {
        "en": "A proper emulsified dressing with anchovy, garlic and lemon, torn sourdough croutons and lots of parmesan.",
        "de": "Ein richtig aufgeschlagenes Dressing mit Sardelle, Knoblauch und Zitrone, gezupfte Sauerteig-Croûtons und viel Parmesan."
      },
      "note": {
        "en": "the anchovy melts. nobody will know.",
        "de": "die sardelle schmilzt. niemand wird’s merken."
      },
