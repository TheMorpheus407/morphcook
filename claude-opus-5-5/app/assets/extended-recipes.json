      "steps": [
        {
          "text": {
            "en": "Boil the potatoes in their skins until just tender.",
            "de": "Kartoffeln in der Schale knapp gar kochen."
          },
          "timer_seconds": 1200
        },
        {
          "text": {
            "en": "Warm the stock with finely diced onion, vinegar, mustard, salt and pepper. Peel and slice the warm potatoes into it and let them soak it up.",
