          "id": "kombu",
          "qty": 1,
          "unit": "sheet"
        },
        {
          "id": "shiitake",
          "qty": 6,
          "unit": "pc"
        },
        {
          "id": "egg",
          "qty": 4,
          "unit": "pc"
        },
        {
          "id": "ramen-noodles",
          "qty": 480,
          "unit": "g"
        },
        {
          "id": "spring-onion",
          "qty": 4,
          "unit": "pc"
        },
        {
          "id": "nori",
          "qty": 4,
          "unit": "sheet"
        },
        {
          "id": "sesame-oil",
          "qty": 1,
          "unit": "tbsp"
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Roll and tie the pork belly. Brown it all over in a heavy pot.",
            "de": "Den Schweinebauch rollen und binden. In einem schweren Topf rundum anbraten."
          },
          "timer_seconds": 600
        },
        {
          "text": {
            "en": "Add soy, mirin, sugar, half the garlic and ginger and water to half-cover. Braise, turning every half hour.",
            "de": "Soja, Mirin, Zucker, die Hälfte von Knoblauch und Ingwer und Wasser bis zur halben Höhe dazugeben. Schmoren und jede halbe Stunde wenden."
          },
          "timer_seconds": 9000
        },
        {
          "text": {
            "en": "Meanwhile simmer the stock with kombu, shiitake and the rest of the garlic and ginger. Remove the kombu before it boils hard.",
            "de": "Inzwischen die Brühe mit Kombu, Shiitake und restlichem Knoblauch und Ingwer köcheln. Kombu herausnehmen, bevor es sprudelnd kocht."
          },
          "timer_seconds": 2700
        },
        {
          "text": {
            "en": "Boil the eggs, chill in ice water, peel, and marinate in a few spoons of the braising liquid.",
            "de": "Eier kochen, in Eiswasser abschrecken, pellen und in ein paar Löffeln Schmorflüssigkeit marinieren."
          },
          "timer_seconds": 390
        },
        {
          "text": {
            "en": "Season the broth with some braising liquid. Slice the pork and cook the noodles.",
            "de": "Die Brühe mit etwas Schmorflüssigkeit abschmecken. Fleisch aufschneiden und Nudeln kochen."
          },
          "timer_seconds": 180
        },
        {
          "text": {
            "en": "Build the bowls: noodles, broth, pork, halved egg, spring onion, nori, a drop of sesame oil.",
            "de": "Schalen anrichten: Nudeln, Brühe, Fleisch, halbiertes Ei, Frühlingszwiebel, Nori, ein Tropfen Sesamöl."
          }
        }
      ]
    },
