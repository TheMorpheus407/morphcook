      ],
      "steps": [
        {
          "text": {
            "en": "Rinse and cook the rice.",
            "de": "Reis waschen und garen."
          },
          "timer_seconds": 900
        },
        {
          "text": {
            "en": "Scoop the thick cream from the top of the can into a hot wok with the oil. Fry the curry paste in it until fragrant and oily.",
            "de": "Die dicke Creme oben aus der Dose mit dem Öl in einen heißen Wok geben. Currypaste darin braten, bis sie duftet und sich Öl absetzt."
          },
          "timer_seconds": 180
        },
        {
          "text": {
            "en": "Add the chicken and stir until coated, then the rest of the coconut milk, fish sauce and palm sugar.",
            "de": "Hähnchen dazugeben und wenden, dann restliche Kokosmilch, Fischsauce und Palmzucker."
          }
        },
        {
          "text": {
            "en": "Add eggplant and beans and simmer until tender.",
            "de": "Aubergine und Bohnen dazugeben und köcheln, bis sie weich sind."
          },
          "timer_seconds": 720
        },
        {
          "text": {
            "en": "Tear in the basil, squeeze in lime, and serve over rice.",
            "de": "Basilikum hineinzupfen, Limette auspressen und über Reis servieren."
          }
        }
      ]
    },
