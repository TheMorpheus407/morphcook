    {
      "id": "ramen-pork",
      "dish_id": "ramen",
      "title": {
        "en": "Slow Pork Belly Ramen",
        "de": "Ramen mit langsam gegartem Schweinebauch"
      },
      "blurb": {
        "en": "Rolled pork belly braised in soy and mirin, a rich chicken-kombu broth, marinated eggs with sunset yolks.",
        "de": "Gerollter Schweinebauch, in Soja und Mirin geschmort, eine kräftige Hühner-Kombu-Brühe, marinierte Eier mit Sonnenuntergangs-Dottern."
      },
      "note": {
        "en": "6½ minutes for the eggs. set a timer, really.",
        "de": "6½ minuten für die eier. wirklich timer stellen."
      },
      "cuisine": "japanese",
      "diet": "classic",
      "effort": "hard",
      "time_minutes": 240,
