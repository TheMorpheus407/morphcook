          "unit": "to-taste"
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Render the diced pancetta in oil and butter, then add finely chopped onion, carrot and celery and sweat gently.",
            "de": "Gewürfelte Pancetta in Öl und Butter auslassen, dann fein gehackte Zwiebel, Karotte und Sellerie dazugeben und sanft anschwitzen."
          },
          "timer_seconds": 900
        },
        {
          "text": {
            "en": "Add the beef and cook, breaking it up, until it loses its pink.",
            "de": "Das Rind dazugeben und krümelig braten, bis es nicht mehr rosa ist."
          },
          "timer_seconds": 480
        },
        {
          "text": {
            "en": "Pour in the milk with a pinch of nutmeg and let it bubble away almost completely. Then the wine, same again.",
            "de": "Milch mit einer Prise Muskat angießen und fast vollständig einkochen lassen. Dann den Wein, genauso."
          },
          "timer_seconds": 600
        },
        {
          "text": {
            "en": "Stir in tomato paste and tomatoes, season, and simmer on the lowest heat, half covered, stirring now and then.",
            "de": "Tomatenmark und Tomaten einrühren, würzen und auf kleinster Stufe halb zugedeckt köcheln, ab und zu umrühren."
          },
          "timer_seconds": 7200
        },
        {
          "text": {
            "en": "Cook the pasta, toss it with the ragù and a splash of cooking water, and finish with parmesan.",
            "de": "Nudeln garen, mit dem Ragù und einem Schluck Kochwasser schwenken und mit Parmesan vollenden."
          },
          "timer_seconds": 540
        }
      ]
    },
