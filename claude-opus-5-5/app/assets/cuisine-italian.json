    {
      "id": "bolognese-classic",
      "dish_id": "bolognese",
      "title": {
        "en": "Slow Ragù Bolognese",
        "de": "Langsames Ragù Bolognese"
      },
      "blurb": {
        "en": "Soffritto sweated slowly, beef and pancetta, a splash of white wine and milk, and two unhurried hours on the lowest flame.",
        "de": "Langsam angeschwitztes Soffritto, Rind und Pancetta, ein Schluck Weißwein und Milch — und zwei gemächliche Stunden auf kleinster Flamme."
      },
      "note": {
        "en": "the milk goes in first. it makes the meat silky.",
        "de": "die milch kommt zuerst. sie macht das fleisch seidig."
      },
      "cuisine": "italian",
      "diet": "classic",
      "effort": "hard",
