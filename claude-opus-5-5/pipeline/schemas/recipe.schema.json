{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "morphcook/recipe",
  "type": "object",
  "required": ["id", "dish_id", "title", "blurb", "note", "diet", "effort", "time_minutes", "servings", "calories_per_serving", "macros", "contains", "techniques", "meal_types", "ingredients", "steps"],
  "$defs": {
    "text": {"type": "object", "required": ["en", "de"], "additionalProperties": {"type": "string", "minLength": 1}}
  },
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "dish_id": {"type": "string"},
    "title": {"$ref": "#/$defs/text"},
    "blurb": {"$ref": "#/$defs/text"},
    "note": {"$ref": "#/$defs/text"},
    "diet": {"type": "string"},
    "effort": {"enum": ["easy", "medium", "hard"]},
    "time_minutes": {"type": "integer", "minimum": 1},
    "servings": {"type": "integer", "minimum": 1},
    "calories_per_serving": {"type": "integer", "minimum": 0},
    "macros": {"type": "object", "required": ["protein_g", "carbs_g", "fat_g"]},
    "contains": {"type": "array", "items": {"type": "string"}},
    "attributes": {"type": "array", "items": {"type": "string"}},
    "techniques": {"type": "array", "items": {"type": "string"}},
    "meal_types": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "ingredients": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "unit"], "properties": {
        "id": {"type": "string"}, "qty": {"type": ["number", "null"]}, "unit": {"type": "string"}, "note": {"$ref": "#/$defs/text"}
      }}
    },
    "steps": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["text"], "properties": {
        "text": {"$ref": "#/$defs/text"}, "timer_seconds": {"type": "integer", "minimum": 1}
      }}
    }
  }
}
