{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "morphcook/dish",
  "type": "object",
  "required": ["id", "name", "hero", "caption", "stripe_color", "variants", "partition_id", "secondary_partitions", "cuisine_tags", "frequency_tier"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "object", "required": ["en", "de"]},
    "hero": {"type": "object", "required": ["en", "de"]},
    "caption": {"type": "object", "required": ["en", "de"]},
    "stripe_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "variants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "partition_id": {"type": "string"},
    "secondary_partitions": {"type": "array", "items": {"type": "string"}},
    "cuisine_tags": {"type": "array", "items": {"type": "string"}},
    "frequency_tier": {"enum": ["high", "medium", "low"]}
  }
}
