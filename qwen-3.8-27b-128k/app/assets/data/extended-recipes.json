      ],
      "steps": [
        {
          "n": 1,
          "text": {
            "en": "Crisp the beef in butter, set aside.",
            "de": "Brate das Rind in Butter, zur Seite stellen."
          },
          "seconds": 300
        },
        {
          "n": 2,
          "text": {
            "en": "Sweat the onion strips until soft.",
            "de": "Schweiß die Zwiebelstreifen, bis sie weich sind."
          },
          "seconds": 600
