{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphcook.app/schemas/ontology.schema.json",
  "title": "MorphCook ontology",
  "description": "The shared vocabulary of the app: flags, diets, attributes, dimensions, units and aisles. Every flag, diet label, meal type, technique and unit that a recipe uses has to exist here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "languages", "default_language", "flags", "compound_flags", "flag_ui", "derived_attributes",
    "attribute_categories", "attributes", "dimensions", "meal_types", "cuisines", "filter_ui", "units", "aisles"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "languages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z]{2,3}$" },
          "name": { "type": "string", "minLength": 2 }
        }
      }
    },
    "default_language": { "type": "string", "pattern": "^[a-z]{2,3}$" },
    "flags": {
      "type": "object",
      "description": "Things an ingredient can bring: meat, dairy, gluten, alcohol. A flag may sit below a parent flag (pork below meat).",
      "additionalProperties": { "$ref": "#/$defs/flag" }
    },
    "compound_flags": {
      "type": "object",
      "description": "Diets as bundles of flags. Avoiding `vegan` avoids everything it expands to.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expands"],
        "properties": {
          "name": { "$ref": "#/$defs/localizedText" },
          "expands": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "flag_ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diets", "avoid_groups", "required_attributes"],
      "properties": {
        "diets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "required_attributes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "avoid_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "flags"],
            "properties": {
              "id": { "type": "string", "minLength": 2 },
              "name": { "$ref": "#/$defs/localizedText" },
              "flags": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
            }
          }
        }
      }
    },
    "derived_attributes": {
      "type": "object",
      "description": "Diet labels a recipe earns from its flags or macros: the `vegan` attribute holds when no vegan-breaking flag is present.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "avoid_compound": { "type": "string" },
          "without_flags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "max_carbs_g": { "type": "number", "minimum": 0 },
          "min_protein_g": { "type": "number", "minimum": 0 }
        }
      }
    },
    "attribute_categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "$ref": "#/$defs/localizedText" } }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "name"],
        "properties": {
          "category": { "type": "string", "minLength": 2 },
          "name": { "$ref": "#/$defs/localizedText" }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "description": "The rows of the variant switcher on the dish page.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "source", "values"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "name": { "$ref": "#/$defs/localizedText" },
          "source": { "type": "string", "minLength": 2 },
          "display": { "type": "string", "enum": ["approx_kcal"] },
          "values": { "type": "array", "minItems": 2, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "meal_types": { "type": "object", "additionalProperties": { "$ref": "#/$defs/localizedText" } },
    "cuisines": { "type": "object", "additionalProperties": { "$ref": "#/$defs/localizedText" } },
    "filter_ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups"],
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "kind", "values"],
            "properties": {
              "id": { "type": "string", "minLength": 2 },
              "name": { "$ref": "#/$defs/localizedText" },
              "kind": { "type": "string", "enum": ["meal", "attribute", "cuisine"] },
              "values": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            }
          }
        }
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "name"],
        "properties": {
          "family": { "type": "string", "enum": ["mass", "volume", "count", "free"] },
          "to_base": { "type": "number", "minimum": 0 },
          "name": {
            "type": "object",
            "required": ["en", "de"],
            "additionalProperties": {
              "type": "object",
              "required": ["one", "other"],
              "description": "Empty for count units such as `piece`: \"2 eggs\" carries no unit word.",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "aisles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "name": { "$ref": "#/$defs/localizedText" }
        }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": ["en", "de"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "group"],
      "properties": {
        "name": { "$ref": "#/$defs/localizedText" },
        "group": { "type": "string", "enum": ["allergen", "animal", "seafood", "other"] },
        "parent": { "type": "string" },
        "derived": { "type": "boolean", "description": "Set by the tooling (meat-dairy-combo), never by an ingredient." }
      }
    }
  }
}
