{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphcook.app/schemas/dish.schema.json",
  "title": "MorphCook Dish Family",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "subtitle",
    "story",
    "cuisine",
    "meal_slots",
    "seasons",
    "default_variant_id",
    "variant_ids"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "title": {
      "type": "object",
      "required": ["en", "de"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 }
      }
    },
    "subtitle": {
      "type": "object",
      "required": ["en", "de"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 }
      }
    },
    "story": {
      "type": "object",
      "required": ["en", "de"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 }
      }
    },
    "cuisine": { "type": "string" },
    "meal_slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["breakfast", "lunch", "dinner", "snack"]
      }
    },
    "seasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "default_variant_id": { "type": "string", "minLength": 1 },
    "variant_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "hero_palette": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
