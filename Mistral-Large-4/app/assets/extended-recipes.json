    {
      "id": "kaesespaetzle-classic",
      "dish_id": "kaesespaetzle",
      "title": {
        "en": "Classic Käsespätzle",
        "de": "Klassische Käsespätzle"
      },
      "subtitle": {
        "en": "soft noodles, molten emmental, crisp onions",
        "de": "weiche nudeln, geschmolzener emmentaler, knusprige zwiebeln"
      },
      "diet": "vegetarian",
      "effort": "medium",
      "time_minutes": 45,
      "calories_per_serving": 640,
      "servings": 4,
      "meal_type": "dinner",
      "ingredients": [
        {
          "ingredient_id": "wheat-flour",
          "amount": 400,
          "unit": "g"
        },
        {
          "ingredient_id": "egg",
          "amount": 4,
          "unit": "piece"
        },
        {
          "ingredient_id": "milk",
          "amount": 200,
          "unit": "ml"
        },
        {
          "ingredient_id": "salt",
          "amount": 1,
          "unit": "tsp"
        },
        {
          "ingredient_id": "nutmeg",
          "amount": 1,
          "unit": "pinch"
        },
        {
          "ingredient_id": "emmental",
          "amount": 200,
          "unit": "g",
          "note": {
            "en": "grated",
            "de": "gerieben"
          }
        },
        {
          "ingredient_id": "onion",
          "amount": 3,
          "unit": "piece",
          "note": {
            "en": "sliced into rings",
            "de": "in ringe geschnitten"
          }
        },
        {
          "ingredient_id": "butter",
          "amount": 80,
          "unit": "g"
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Whisk flour, eggs, milk, salt and nutmeg into a thick, elastic dough; rest for 15 minutes.",
            "de": "Mehl, Eier, Milch, Salz und Muskat zu einem zäh-elastischen Teig verrühren, 15 Minuten ruhen lassen."
          },
          "timer_minutes": 15
        },
        {
          "text": {
            "en": "Bring a large pot of salted water to a boil.",
            "de": "Einen großen Topf Salzwasser aufkochen."
          }
        },
        {
          "text": {
            "en": "Press the dough through a Spätzle maker into the boiling water; cook until the Spätzle float.",
            "de": "Den Teig durch die Spätzlepresse ins kochende Wasser drücken, aufkochen lassen, bis die Spätzle oben schwimmen."
          },
          "timer_minutes": 3
        },
        {
          "text": {
            "en": "Meanwhile, caramelize the onion rings slowly in butter until deep golden.",
            "de": "Inzwischen die Zwiebelringe in Butter langsam tief goldbraun karamellisieren."
          },
          "timer_minutes": 20
        },
        {
          "text": {
            "en": "Layer the Spätzle and emmental in a buttered dish, top with more cheese, and bake briefly until molten.",
            "de": "Die Spätzle und den Emmentaler in eine gebutterte Form schichten, mit Käse abschließen und kurz überbacken, bis er geschmolzen ist."
          },
          "timer_minutes": 8
        },
        {
          "text": {
            "en": "Serve topped with the caramelized onions.",
            "de": "Mit den karamellisierten Zwiebeln servieren."
          }
        }
      ],
      "macros": {
        "kcal": 640,
        "protein_g": 26,
        "carbs_g": 68,
        "fat_g": 26
      },
      "tags": [
        "german",
