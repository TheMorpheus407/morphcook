      "steps": [
        {
          "text": {
            "en": "Slice the döner meat thinly. Toss with olive oil, cumin, smoked paprika, oregano and salt.",
            "de": "Das Dönerfleisch dünn schneiden. Mit Olivenöl, Kreuzkümmel, Paprika, Oregano und Salz vermengen."
          }
        },
        {
          "text": {
            "en": "Heat a pan over high heat and sear the meat in batches until browned and crisp at the edges.",
            "de": "Eine Pfanne stark erhitzen, das Fleisch portionsweise scharf anbraten, bis es gebräunt und knusprig ist."
          }
        },
        {
          "text": {
            "en": "Dice cucumber and tomato, slice the red onion thinly, chop the parsley.",
            "de": "Gurke und Tomate würfeln, die rote Zwiebel dünn schneiden, die Petersilie hacken."
          }
        },
        {
          "text": {
            "en": "Whisk the yogurt with crushed garlic, a squeeze of lemon and a pinch of salt.",
            "de": "Den Joghurt mit gepresstem Knoblauch, einem Spritzer Zitrone und einer Prise Salz verrühren."
          }
        },
        {
          "text": {
            "en": "Warm the tortillas in a dry pan, 30 seconds per side.",
            "de": "Die Tortillas in einer trockenen Pfanne von beiden Seiten 30 Sekunden erwärmen."
          }
        },
        {
          "text": {
            "en": "Assemble: sauce, salad, meat — fold and eat with your hands.",
            "de": "Servieren: Sauce, Salat, Fleisch — falten und mit den Händen essen."
          }
        }
      ],
