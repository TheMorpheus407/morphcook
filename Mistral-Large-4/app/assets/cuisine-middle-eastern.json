    {
      "id": "shakshuka-classic",
      "dish_id": "shakshuka",
      "title": {
        "en": "Classic Shakshuka",
        "de": "Klassische Shakshuka"
      },
      "subtitle": {
        "en": "eggs poached in spiced tomato, feta on top",
        "de": "eier in gewürzter tomate pochiert, feta oben drauf"
      },
      "diet": "classic",
      "effort": "easy",
      "time_minutes": 30,
      "calories_per_serving": 520,
      "servings": 2,
      "meal_type": "breakfast",
      "ingredients": [
        {
          "ingredient_id": "canned-tomatoes",
          "amount": 1,
          "unit": "can",
          "note": {
            "en": "400 g",
            "de": "400 g"
          }
        },
        {
          "ingredient_id": "bell-pepper",
          "amount": 2,
          "unit": "piece"
        },
        {
          "ingredient_id": "onion",
          "amount": 1,
          "unit": "piece"
        },
        {
          "ingredient_id": "garlic",
          "amount": 3,
          "unit": "clove"
        },
        {
          "ingredient_id": "egg",
          "amount": 4,
          "unit": "piece"
        },
        {
          "ingredient_id": "olive-oil",
          "amount": 2,
          "unit": "tbsp"
        },
        {
          "ingredient_id": "cumin",
          "amount": 1,
          "unit": "tsp"
        },
        {
          "ingredient_id": "smoked-paprika",
          "amount": 1,
          "unit": "tsp"
        },
        {
          "ingredient_id": "chili-flakes",
          "amount": 0.5,
          "unit": "tsp"
        },
        {
          "ingredient_id": "salt",
          "amount": 1,
          "unit": "tsp"
        },
        {
          "ingredient_id": "feta",
          "amount": 80,
          "unit": "g"
        },
        {
          "ingredient_id": "parsley",
          "amount": 1,
          "unit": "bunch"
        },
        {
          "ingredient_id": "bread",
          "amount": 2,
          "unit": "slice",
          "note": {
            "en": "to serve",
            "de": "zum servieren"
          }
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Sauté the onion and bell pepper in olive oil until soft.",
            "de": "Zwiebel und Paprika in Olivenöl weich anschwitzen."
          },
          "timer_minutes": 8
        },
        {
          "text": {
            "en": "Add the garlic and spices, cook until fragrant.",
            "de": "Knoblauch und Gewürze dazugeben, duften lassen."
          },
          "timer_minutes": 1
        },
        {
          "text": {
            "en": "Pour in the tomatoes, crush them with a spoon and simmer until the sauce is thick.",
            "de": "Die Tomaten dazugeben, mit einem Löffel zerdrücken und zu einer dicken Sauce köcheln lassen."
          },
          "timer_minutes": 12
        },
        {
          "text": {
            "en": "Make four wells in the sauce and crack an egg into each.",
            "de": "Vier Mulden in die Sauce drücken und je ein Ei hineinschlagen."
          }
        },
        {
          "text": {
            "en": "Cover and poach until the whites are set but the yolks still run.",
            "de": "Zugedeckt pochieren, bis das Eiweiß gestockt ist, das Eigelb aber noch weich."
          },
          "timer_minutes": 6
        },
        {
          "text": {
            "en": "Crumble the feta over the top, scatter parsley, serve with bread.",
            "de": "Den Feta darüber bröseln, Petersilie streuen, mit Brot servieren."
          }
        }
      ],
