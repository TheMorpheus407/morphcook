          "amount": 3,
          "unit": "tbsp",
          "note": {
            "en": "as binder",
            "de": "als binder"
          }
        },
        {
          "ingredient_id": "salt",
          "amount": 1,
          "unit": "tsp"
        },
        {
          "ingredient_id": "vegetable-oil",
          "amount": 300,
          "unit": "ml",
          "note": {
            "en": "for frying",
            "de": "zum frittieren"
          }
        },
        {
          "ingredient_id": "pita",
          "amount": 4,
          "unit": "piece"
        },
        {
          "ingredient_id": "yogurt",
          "amount": 200,
          "unit": "g"
        },
        {
          "ingredient_id": "tomato",
          "amount": 2,
          "unit": "piece",
          "note": {
            "en": "diced",
            "de": "gewürfelt"
          }
        },
        {
          "ingredient_id": "lemon",
          "amount": 1,
          "unit": "piece"
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Drain the chickpeas and pat them dry. Pulse with parsley, cilantro, garlic, cumin, coriander, baking soda and salt into coarse crumbs — never a purée.",
            "de": "Die Kichererbsen abtropfen und trocken tupfen. Mit Petersilie, Koriander, Knoblauch, Kreuzkümmel, Korianderpulver, Natron und Salz zu groben Krümeln hacken — niemals pürieren."
          }
        },
        {
          "text": {
            "en": "Fold in the flour and rest the mixture in the fridge for 15 minutes.",
            "de": "Das Mehl unterheben und die Masse 15 Minuten im Kühlschrank ruhen lassen."
          },
          "timer_minutes": 15
        },
        {
          "text": {
            "en": "Form walnut-sized balls and press them slightly flat.",
            "de": "Walnussgroße Bällchen formen und leicht flach drücken."
          }
        },
        {
          "text": {
            "en": "Deep-fry in hot oil until deep golden, 3-4 minutes per batch.",
            "de": "In heißem Öl goldbraun frittieren, 3-4 Minuten pro Portion."
          },
          "timer_minutes": 4
        },
        {
          "text": {
            "en": "Whisk the yogurt with lemon juice and a pinch of salt.",
            "de": "Den Joghurt mit Zitronensaft und einer Prise Salz verrühren."
          }
        },
        {
          "text": {
            "en": "Stuff the pitas with falafel, diced tomato and the yogurt sauce.",
            "de": "Die Pitas mit Falafel, Tomatenwürfeln und der Joghurtsauce füllen."
          }
        }
