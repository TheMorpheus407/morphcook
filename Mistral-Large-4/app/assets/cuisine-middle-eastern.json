    {
      "id": "falafel-classic",
      "dish_id": "falafel",
      "title": {
        "en": "Classic Falafel",
        "de": "Klassischer Falafel"
      },
      "subtitle": {
        "en": "herbs, chickpeas, yogurt in warm pita",
        "de": "kräuter, kichererbsen, joghurt im warmen pita"
      },
      "diet": "vegetarian",
      "effort": "medium",
      "time_minutes": 40,
      "calories_per_serving": 520,
      "servings": 4,
      "meal_type": "lunch",
      "ingredients": [
        {
          "ingredient_id": "chickpeas",
          "amount": 2,
          "unit": "can",
          "note": {
            "en": "drained",
            "de": "abgetropft"
          }
        },
        {
          "ingredient_id": "parsley",
          "amount": 1,
          "unit": "bunch"
        },
        {
          "ingredient_id": "cilantro",
          "amount": 1,
          "unit": "bunch"
        },
        {
          "ingredient_id": "garlic",
          "amount": 4,
          "unit": "clove"
        },
        {
          "ingredient_id": "cumin",
          "amount": 2,
          "unit": "tsp"
        },
        {
          "ingredient_id": "coriander",
          "amount": 2,
          "unit": "tsp"
        },
        {
          "ingredient_id": "baking-soda",
          "amount": 1,
          "unit": "tsp"
        },
        {
