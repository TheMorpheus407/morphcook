{
  "partition_id": "cuisine-italian",
  "recipes": [
    {
      "id": "alfredo-classic",
      "dish_id": "fettuccine-alfredo",
      "title": {
        "en": "Classic Fettuccine Alfredo",
        "de": "Klassische Fettuccine Alfredo"
      },
      "subtitle": {
        "en": "butter, cream, parmesan — no shortcuts",
        "de": "butter, sahne, parmesan — keine kompromisse"
      },
      "diet": "classic",
      "effort": "easy",
      "time_minutes": 20,
      "calories_per_serving": 720,
      "servings": 2,
      "meal_type": "dinner",
      "ingredients": [
        {
          "ingredient_id": "fettuccine",
          "amount": 250,
          "unit": "g"
        },
        {
          "ingredient_id": "butter",
          "amount": 60,
          "unit": "g"
        },
        {
          "ingredient_id": "parmesan",
          "amount": 80,
          "unit": "g",
          "note": {
            "en": "finely grated",
            "de": "fein gerieben"
          }
        },
        {
          "ingredient_id": "cream",
          "amount": 100,
          "unit": "ml"
        },
        {
          "ingredient_id": "black-pepper",
          "amount": 1,
          "unit": "tsp",
          "note": {
            "en": "freshly cracked",
            "de": "frisch gemahlen"
          }
        },
        {
          "ingredient_id": "nutmeg",
          "amount": 1,
          "unit": "pinch"
        },
        {
          "ingredient_id": "salt",
          "amount": 1,
          "unit": "tsp"
        },
        {
          "ingredient_id": "parsley",
          "amount": 1,
          "unit": "bunch",
          "note": {
            "en": "chopped, for garnish",
            "de": "gehackt, zum garnieren"
          }
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Bring a large pot of salted water to a boil and cook the fettuccine until al dente.",
            "de": "Einen großen Topf Salzwasser aufkochen, die Fettuccine al dente kochen."
          },
          "timer_minutes": 9
        },
        {
          "text": {
            "en": "Meanwhile, melt the butter in a large pan over medium heat.",
            "de": "Inzwischen die Butter in einer großen Pfanne bei mittlerer Hitze schmelzen."
          }
        },
        {
          "text": {
            "en": "Stir in the cream and let it simmer gently for 2 minutes.",
            "de": "Die Sahne einrühren und 2 Minuten leicht köcheln lassen."
          },
          "timer_minutes": 2
        },
        {
          "text": {
            "en": "Drain the pasta, reserving 120 ml of the starchy cooking water.",
            "de": "Die Pasta abgießen, dabei 120 ml stärkehaltiges Kochwasser auffangen."
          }
        },
        {
          "text": {
            "en": "Toss the pasta in the pan with the butter-cream, adding parmesan and pasta water little by little until the sauce is glossy.",
            "de": "Die Pasta in die Pfanne geben, Parmesan und nach und nach Kochwasser zugeben, bis die Sauce glänzt."
          }
        },
        {
          "text": {
            "en": "Season generously with black pepper and a pinch of nutmeg, garnish with parsley.",
            "de": "Reichlich mit Pfeffer und einer Prise Muskat abschmecken, mit Petersilie garnieren."
          }
        }
      ],
      "macros": {
        "kcal": 720,
        "protein_g": 22,
        "carbs_g": 74,
        "fat_g": 36
      },
