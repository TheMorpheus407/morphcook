        "de": "zucchini-streifen, guanciale, eigelb"
      },
      "diet": "keto",
      "effort": "medium",
      "time_minutes": 25,
      "calories_per_serving": 620,
      "servings": 2,
      "meal_type": "dinner",
      "ingredients": [
        {
