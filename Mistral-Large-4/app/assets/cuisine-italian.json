          "amount": 1,
          "unit": "clove"
        },
        {
          "ingredient_id": "black-pepper",
          "amount": 1,
          "unit": "tsp",
          "note": {
            "en": "freshly cracked",
            "de": "frisch gemahlen"
          }
        },
        {
          "ingredient_id": "nutmeg",
          "amount": 1,
          "unit": "pinch"
        },
        {
          "ingredient_id": "salt",
          "amount": 1,
          "unit": "tsp"
        },
        {
          "ingredient_id": "parsley",
          "amount": 1,
          "unit": "bunch",
          "note": {
            "en": "chopped, for garnish",
            "de": "gehackt, zum garnieren"
          }
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Blend the soaked cashews with 120 ml of water until completely smooth.",
            "de": "Die eingeweichten Cashews mit 120 ml Wasser ganz glatt pürieren."
          }
        },
        {
          "text": {
            "en": "Cook the fettuccine in salted water until al dente.",
            "de": "Die Fettuccine in Salzwasser al dente kochen."
          },
          "timer_minutes": 9
        },
        {
          "text": {
            "en": "Melt the vegan butter in a pan, add the garlic, then the cashew cream and coconut cream.",
            "de": "Die vegane Butter in einer Pfanne schmelzen, den Knoblauch dazugeben, dann Cashew-Sahne und Kokoscreme."
          }
        },
        {
          "text": {
            "en": "Simmer the sauce for 3 minutes, then toss in the drained pasta with nutritional yeast.",
            "de": "Die Sauce 3 Minuten köcheln lassen, dann die abgetropfte Pasta mit den Hefeflocken unterheben."
          },
          "timer_minutes": 3
        },
        {
          "text": {
            "en": "Season with black pepper, nutmeg and salt; the sauce should coat the pasta, not pool.",
            "de": "Mit Pfeffer, Muskat und Salz abschmecken; die Sauce soll die Pasta umhüllen, nicht baden."
          }
        },
        {
          "text": {
            "en": "Garnish with parsley and serve immediately.",
            "de": "Mit Petersilie garnieren und sofort servieren."
          }
        }
      ],
