          "amount": 50,
          "unit": "g"
        },
        {
          "ingredient_id": "cream",
          "amount": 120,
          "unit": "ml"
        },
        {
          "ingredient_id": "parmesan",
          "amount": 80,
          "unit": "g",
          "note": {
            "en": "finely grated",
            "de": "fein gerieben"
          }
        },
        {
          "ingredient_id": "garlic",
          "amount": 2,
          "unit": "clove"
        },
        {
          "ingredient_id": "black-pepper",
          "amount": 1,
          "unit": "tsp"
        },
        {
          "ingredient_id": "nutmeg",
          "amount": 1,
          "unit": "pinch"
        },
        {
          "ingredient_id": "salt",
          "amount": 1,
          "unit": "tsp"
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Spiralize the zucchini into noodles; if you have a mandoline, cut long ribbons instead.",
            "de": "Die Zucchini zu Nudeln spiralieren; mit einem Hobel gehen auch lange Streifen."
          }
        },
        {
          "text": {
            "en": "Melt the butter in a large pan, sauté the garlic for 30 seconds.",
            "de": "Die Butter in einer großen Pfanne schmelzen, den Knoblauch 30 Sekunden anschwitzen."
          }
        },
        {
          "text": {
            "en": "Add the cream and simmer for 3 minutes until slightly thickened.",
