            "en": "2 yolks + 1 whole",
            "de": "2 eigelb + 1 ganzes"
          }
        },
        {
          "ingredient_id": "parmesan",
          "amount": 60,
          "unit": "g",
          "note": {
            "en": "finely grated",
            "de": "fein gerieben"
          }
        },
        {
          "ingredient_id": "pecorino",
          "amount": 40,
          "unit": "g",
          "note": {
            "en": "finely grated",
            "de": "fein gerieben"
          }
        },
        {
          "ingredient_id": "black-pepper",
          "amount": 2,
          "unit": "tsp",
          "note": {
            "en": "freshly cracked",
            "de": "frisch gemahlen"
          }
        },
        {
          "ingredient_id": "salt",
          "amount": 1,
          "unit": "tsp"
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Cut the zucchini into long ribbons with a peeler; salt lightly and set aside.",
            "de": "Die Zucchini mit einem Sparschäler in lange Streifen hobeln, leicht salzen, beiseitestellen."
          }
        },
        {
          "text": {
            "en": "Render the guanciale until crisp, keeping the fat.",
            "de": "Den Guanciale knusprig auslassen, das Fett auffangen."
          }
        },
        {
          "text": {
            "en": "Sauté the zucchini ribbons in the guanciale fat for 2 minutes only.",
            "de": "Die Zucchinistreifen 2 Minuten im Guancialefett anschwitzen."
          },
          "timer_minutes": 2
        },
        {
          "text": {
            "en": "Whisk the eggs, both cheeses and plenty of black pepper.",
            "de": "Eier, beide Käsesorten und reichlich Pfeffer verquirlen."
          }
        },
        {
          "text": {
            "en": "Off the heat, toss the zucchini with the egg mixture — the residual heat makes the sauce.",
            "de": "Vom Herd nehmen, die Zucchini mit der Eimischung schwenken — die Restwärme macht die Sauce."
          }
        },
        {
          "text": {
            "en": "Serve immediately with more pepper.",
            "de": "Sofort mit mehr Pfeffer servieren."
          }
