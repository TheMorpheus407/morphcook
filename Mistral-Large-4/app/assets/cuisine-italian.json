    {
      "id": "carbonara-classic",
      "dish_id": "carbonara",
      "title": {
        "en": "Classic Carbonara",
        "de": "Klassische Carbonara"
      },
      "subtitle": {
        "en": "guanciale, egg, pecorino — no cream, ever",
        "de": "guanciale, ei, pecorino — nie sahne"
      },
      "diet": "classic",
      "effort": "medium",
      "time_minutes": 25,
      "calories_per_serving": 750,
      "servings": 2,
      "meal_type": "dinner",
      "ingredients": [
        {
          "ingredient_id": "spaghetti",
          "amount": 250,
          "unit": "g"
        },
        {
          "ingredient_id": "guanciale",
          "amount": 150,
          "unit": "g",
          "note": {
            "en": "diced",
            "de": "gewürfelt"
          }
        },
        {
          "ingredient_id": "egg",
          "amount": 3,
          "unit": "piece",
          "note": {
            "en": "2 yolks + 1 whole",
            "de": "2 eigelb + 1 ganzes"
          }
        },
        {
          "ingredient_id": "parmesan",
          "amount": 60,
          "unit": "g",
          "note": {
            "en": "finely grated",
            "de": "fein gerieben"
          }
        },
        {
          "ingredient_id": "pecorino",
          "amount": 40,
          "unit": "g",
          "note": {
            "en": "finely grated",
            "de": "fein gerieben"
          }
        },
        {
          "ingredient_id": "black-pepper",
          "amount": 2,
          "unit": "tsp",
          "note": {
            "en": "freshly cracked",
            "de": "frisch gemahlen"
          }
        },
        {
          "ingredient_id": "salt",
          "amount": 1,
          "unit": "tsp"
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Boil the spaghetti in salted water until al dente.",
            "de": "Die Spaghetti in Salzwasser al dente kochen."
          },
          "timer_minutes": 10
        },
        {
          "text": {
            "en": "Render the guanciale in a pan until crisp, keeping the fat.",
            "de": "Den Guanciale in einer Pfanne knusprig auslassen, das Fett auffangen."
          }
        },
        {
          "text": {
            "en": "Whisk the eggs, both cheeses and plenty of black pepper in a bowl.",
            "de": "Eier, beide Käsesorten und reichlich Pfeffer in einer Schüssel verquirlen."
          }
        },
        {
          "text": {
            "en": "Drain the pasta and toss it immediately with the hot guanciale fat, off the heat.",
            "de": "Die Pasta abgießen und sofort mit dem heißen Guancialefett vermengen, vom Herd nehmen."
          }
        },
        {
          "text": {
            "en": "Stir in the egg mixture quickly — the residual heat makes the sauce, no cream.",
            "de": "Die Eimischung rasch unterrühren — die Restwärme macht die Sauce, keine Sahne."
          }
        },
        {
          "text": {
            "en": "Add a splash of pasta water if needed, serve with more pepper and cheese.",
            "de": "Nach Bedarf etwas Nudelwasser dazugeben, mit mehr Pfeffer und Käse servieren."
          }
        }
      ],
