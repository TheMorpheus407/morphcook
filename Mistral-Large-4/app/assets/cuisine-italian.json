      "title": {
        "en": "Gluten-Free Carbonara",
        "de": "Glutenfreie Carbonara"
      },
      "subtitle": {
        "en": "rice spaghetti, same roman soul",
        "de": "reis-spaghetti, dieselbe römische seele"
      },
      "diet": "gluten-free",
      "effort": "medium",
      "time_minutes": 25,
      "calories_per_serving": 730,
      "servings": 2,
      "meal_type": "dinner",
      "ingredients": [
        {
          "ingredient_id": "gluten-free-spaghetti",
          "amount": 250,
          "unit": "g"
        },
        {
          "ingredient_id": "guanciale",
          "amount": 150,
          "unit": "g",
          "note": {
            "en": "diced",
            "de": "gewürfelt"
          }
        },
        {
          "ingredient_id": "egg",
          "amount": 3,
          "unit": "piece",
          "note": {
            "en": "2 yolks + 1 whole",
            "de": "2 eigelb + 1 ganzes"
          }
        },
        {
          "ingredient_id": "parmesan",
          "amount": 60,
          "unit": "g",
          "note": {
            "en": "finely grated",
            "de": "fein gerieben"
          }
        },
        {
          "ingredient_id": "pecorino",
          "amount": 40,
          "unit": "g",
          "note": {
            "en": "finely grated",
            "de": "fein gerieben"
          }
        },
        {
          "ingredient_id": "black-pepper",
          "amount": 2,
          "unit": "tsp",
          "note": {
            "en": "freshly cracked",
            "de": "frisch gemahlen"
          }
        },
        {
          "ingredient_id": "salt",
          "amount": 1,
          "unit": "tsp"
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Boil the gluten-free spaghetti until al dente — taste early, rice pasta turns fast.",
            "de": "Die glutenfreien Spaghetti al dente kochen — früh probieren, Reisnudeln werden schnell weich."
          },
          "timer_minutes": 8
        },
        {
          "text": {
            "en": "Render the guanciale in a pan until crisp, keeping the fat.",
            "de": "Den Guanciale in einer Pfanne knusprig auslassen, das Fett auffangen."
          }
        },
        {
          "text": {
            "en": "Whisk the eggs, both cheeses and plenty of black pepper.",
            "de": "Eier, beide Käsesorten und reichlich Pfeffer verquirlen."
          }
        },
        {
          "text": {
            "en": "Drain the pasta, toss immediately with the hot fat, off the heat.",
            "de": "Die Pasta abgießen, sofort mit dem heißen Fett vermengen, vom Herd nehmen."
          }
        },
        {
          "text": {
            "en": "Stir in the egg mixture quickly — residual heat makes the sauce.",
            "de": "Die Eimischung rasch unterrühren — die Restwärme macht die Sauce."
          }
        },
        {
          "text": {
            "en": "Serve with more pepper and cheese.",
            "de": "Mit mehr Pfeffer und Käse servieren."
          }
        }
      ],
      "macros": {
        "kcal": 730,
        "protein_g": 30,
        "carbs_g": 70,
        "fat_g": 37
      },
