    {
      "id": "alfredo-keto",
      "dish_id": "fettuccine-alfredo",
      "title": {
        "en": "Keto Alfredo",
        "de": "Keto-Alfredo"
      },
      "subtitle": {
        "en": "zucchini noodles under a parmesan cream",
        "de": "zucchini-nudeln unter parmesan-sahne"
