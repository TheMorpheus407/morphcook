        },
        {
          "text": {
            "en": "Sauté the onion and garlic in olive oil, add the beef and brown it.",
            "de": "Zwiebel und Knoblauch in Olivenöl anschwitzen, das Hackfleisch dazugeben und anbraten."
          },
          "timer_minutes": 8
        },
        {
          "text": {
            "en": "Add the tomatoes and simmer the ragù until thick.",
            "de": "Die Tomaten dazugeben und das Ragù einköcheln lassen."
          },
          "timer_minutes": 20
        },
        {
          "text": {
            "en": "Make the white sauce: melt the butter, whisk in the cream, then stir in the ricotta and half the parmesan.",
            "de": "Die weiße Sauce machen: Butter schmelzen, Sahne einrühren, dann Ricotta und die Hälfte des Parmesans unterheben."
          }
        },
        {
          "text": {
            "en": "Layer zucchini sheets, ragù and white sauce, finishing with mozzarella and the rest of the parmesan.",
            "de": "Zucchiniblätter, Ragù und weiße Sauce schichten, mit Mozzarella und dem restlichen Parmesan abschließen."
          }
        },
        {
          "text": {
            "en": "Bake until bubbling and golden, let rest, scatter basil.",
            "de": "Backen, bis es blubbert und goldbraun ist, ruhen lassen, Basilikum streuen."
