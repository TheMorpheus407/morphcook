{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MorphCook Recipe",
  "type": "object",
  "required": [
    "id",
    "dish_id",
    "title",
    "description",
    "contains",
    "attributes",
    "tags",
    "dimensions",
    "time_minutes",
    "servings",
    "calories_per_serving",
    "macros",
    "ingredients",
    "steps",
    "note"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "dish_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "object",
      "required": [
        "en",
        "de"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "object",
      "required": [
        "en",
        "de"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "note": {
      "type": "object",
      "required": [
        "en",
        "de"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "contains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attributes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dimensions": {
      "type": "object",
      "required": [
        "diet",
        "effort",
        "calorie-level"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "time_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    },
    "servings": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "calories_per_serving": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "macros": {
      "type": "object",
      "required": [
        "protein",
        "carbs",
        "fat"
      ],
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "ingredients": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "quantity",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "enum": [
              "g",
              "kg",
              "ml",
              "l",
              "tbsp",
              "tsp",
              "clove",
              "piece"
            ]
          },
          "note": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "title",
          "text",
          "timer_seconds"
        ],
        "properties": {
          "title": {
            "type": "object",
            "required": [
              "en",
              "de"
            ],
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "text": {
            "type": "object",
            "required": [
              "en",
              "de"
            ],
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "timer_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          }
        }
      }
    }
  }
}
