{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "dish_id",
    "title",
    "summary",
    "contains",
    "attributes",
    "dimensions",
    "time_minutes",
    "calories_per_serving",
    "servings",
    "macros",
    "ingredients",
    "ingredient_ids",
    "steps",
    "tags"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "dish_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"$ref": "#/$defs/localizedText"},
    "summary": {"$ref": "#/$defs/localizedText"},
    "contains": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "attributes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diet", "effort", "calorie"],
      "properties": {
        "diet": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "calorie": {"type": "string", "minLength": 1}
      }
    },
    "time_minutes": {"type": "integer", "exclusiveMinimum": 0},
    "calories_per_serving": {"type": "number", "minimum": 0},
    "servings": {"type": "number", "exclusiveMinimum": 0},
    "macros": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protein_g", "carbs_g", "fat_g"],
      "properties": {
        "protein_g": {"type": "number", "minimum": 0},
        "carbs_g": {"type": "number", "minimum": 0},
        "fat_g": {"type": "number", "minimum": 0}
      }
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/recipeIngredient"}
    },
    "ingredient_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": ["en", "de"],
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "de": {"type": "string", "minLength": 1}
      },
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "preparationText": {
      "type": "object",
      "required": ["en", "de"],
      "properties": {
        "en": {"type": "string"},
        "de": {"type": "string"}
      },
      "additionalProperties": {"type": "string"}
    },
    "recipeIngredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "amount", "unit", "name", "aisle", "preparation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "amount": {"type": ["number", "null"], "minimum": 0},
        "unit": {"type": "string"},
        "name": {"$ref": "#/$defs/localizedText"},
        "aisle": {"type": "string", "minLength": 1},
        "preparation": {"$ref": "#/$defs/preparationText"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "timer_seconds"],
      "properties": {
        "text": {"$ref": "#/$defs/localizedText"},
        "timer_seconds": {"type": ["integer", "null"], "exclusiveMinimum": 0}
      }
    }
  }
}
