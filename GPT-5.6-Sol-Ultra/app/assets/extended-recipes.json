        {
          "id": "warm-milk",
          "text": {
            "en": "Warm milk with nutmeg in a small pan; do not let it boil.",
            "de": "Milch mit Muskat in einem kleinen Topf erwärmen, aber nicht kochen lassen."
          }
        },
        {
          "id": "blend",
          "text": {
            "en": "Squeeze garlic from its skin. Blend with roasted cauliflower, warm milk and half the parmesan until velvet-smooth.",
            "de": "Knoblauch aus der Schale drücken. Mit Röstblumenkohl, warmer Milch und der Hälfte des Parmesans samtig pürieren."
          }
        },
        {
          "id": "cook-pasta",
          "text": {
            "en": "Cook fettuccine until al dente, adding zucchini ribbons for the final 45 seconds. Reserve pasta water.",
            "de": "Fettuccine al dente kochen und die Zucchinibänder in den letzten 45 Sekunden zugeben. Pastawasser aufbewahren."
          },
          "timer_seconds": 600
        },
        {
          "id": "coat",
          "text": {
            "en": "Toss pasta and zucchini with cauliflower sauce, remaining parmesan and enough pasta water to flow.",
            "de": "Pasta und Zucchini mit Blumenkohlsauce, restlichem Parmesan und genug Pastawasser cremig schwenken."
          }
        },
        {
          "id": "finish",
          "text": {
            "en": "Fold through chopped parsley and serve in warm shallow bowls.",
            "de": "Gehackte Petersilie unterheben und in warmen flachen Schalen servieren."
