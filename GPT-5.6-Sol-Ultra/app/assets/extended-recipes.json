      "steps": [
        {
          "id": "soak-noodles",
          "text": {
            "en": "Soak noodles in cool water until pliable but not soft, then drain thoroughly.",
            "de": "Nudeln in kühlem Wasser einweichen, bis sie biegsam, aber nicht weich sind; gründlich abgießen."
          },
          "timer_seconds": 1500
        },
        {
          "id": "make-sauce",
          "text": {
            "en": "Dissolve tamarind, tamari and palm sugar in 4 tablespoons warm water. Stir in crushed nori.",
            "de": "Tamarinde, Tamari und Palmzucker in 4 EL warmem Wasser auflösen. Zerkrümeltes Nori einrühren."
          }
        },
        {
          "id": "char-mushrooms",
          "text": {
            "en": "Heat a wok until smoking. Fry mushrooms in two batches with oil, pressing them down until their torn edges char.",
            "de": "Wok rauchend heiß werden lassen. Pilze in zwei Portionen mit Öl braten und andrücken, bis die gezupften Kanten rösten."
          },
          "timer_seconds": 720
        },
        {
          "id": "cook-aromatics",
          "text": {
            "en": "Add shallot and garlic, then crumble in tofu and stir-fry until it picks up golden spots.",
            "de": "Schalotten und Knoblauch zugeben, Tofu hineinbröseln und goldfleckig pfannenrühren."
          },
          "timer_seconds": 240
        },
        {
          "id": "glaze-noodles",
          "text": {
            "en": "Return mushrooms, add noodles and sauce and toss over high heat until tender and glossy.",
            "de": "Pilze zurückgeben, Nudeln und Sauce zufügen und bei hoher Hitze weich und glänzend schwenken."
          },
          "timer_seconds": 360
        },
        {
          "id": "finish",
          "text": {
            "en": "Fold in sprouts and spring onion. Serve immediately with peanuts and plenty of lime.",
            "de": "Sprossen und Frühlingszwiebeln unterheben. Sofort mit Erdnüssen und reichlich Limette servieren."
          }
