      "steps": [
        {
          "id": "roast-cauliflower",
          "text": {
            "en": "Roast cauliflower with 1 tablespoon oil and salt at 220°C until dry-edged and tender.",
            "de": "Blumenkohl mit 1 EL Öl und Salz bei 220 °C rösten, bis die Ränder trocken und die Röschen weich sind."
          },
          "timer_seconds": 1500
        },
        {
          "id": "toast-walnuts",
          "text": {
            "en": "Toast walnuts in a dry ovenproof pan until fragrant, then tip onto a board.",
            "de": "Walnüsse in einer trockenen ofenfesten Pfanne duftend rösten, dann auf ein Brett geben."
          },
          "timer_seconds": 300
        },
        {
          "id": "brown-mushrooms",
          "text": {
            "en": "Heat remaining oil in the pan. Brown mushrooms in three batches so they fry instead of steam.",
            "de": "Restliches Öl in der Pfanne erhitzen. Pilze in drei Portionen bräunen, damit sie braten statt dämpfen."
          },
          "timer_seconds": 1080
        },
        {
          "id": "finish-filling",
          "text": {
            "en": "Soften onion and celery, add garlic, tomato paste and thyme, then return mushrooms with walnuts and stock. Reduce until almost dry.",
            "de": "Zwiebel und Sellerie weich dünsten, Knoblauch, Tomatenmark und Thymian zugeben. Pilze, Walnüsse und Brühe einrühren und fast trocken einkochen."
          },
          "timer_seconds": 720
        },
        {
          "id": "puree-topping",
          "text": {
            "en": "Blend roasted cauliflower with butter, cream cheese, half the cheddar and salt until smooth.",
            "de": "Röstblumenkohl mit Butter, Frischkäse, der Hälfte des Cheddars und Salz glatt pürieren."
          }
        },
        {
          "id": "bake",
          "text": {
            "en": "Spread cauliflower over the filling, scatter with remaining cheddar and bake until bubbling and bronzed.",
            "de": "Blumenkohlpüree auf der Füllung verteilen, restlichen Cheddar darüberstreuen und blubbernd goldbraun backen."
          },
          "timer_seconds": 900
        }
      ],
